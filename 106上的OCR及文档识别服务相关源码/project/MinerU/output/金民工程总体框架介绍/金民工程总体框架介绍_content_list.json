        "type": "text",
        "text": "03 PART THREE ",
        "text_level": 1,
        "page_idx": 49
    },
    {
        "type": "text",
        "text": "在脱贫攻坚中的应用",
        "text_level": 1,
        "page_idx": 49
    },
    {
        "type": "image",
        "img_path": "images/c8b78e7574413f0ce0ca57b0d8c79fc93211293fa4e9e22fc96b0e9b5484f4c8.jpg",
