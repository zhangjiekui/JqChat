{

    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python 调试程序: 当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
          "justMyCode": true,  
          "name": "Debug Serve.py",
            "type": "debugpy",
            "request": "launch",
            "module": "r2r.serve",
            "args": [],
            "env": {
              "PYTHONPATH": "${workspaceFolder}"
            },
            "cwd": "${workspaceFolder}"
          }


    ]
}